# Tokyo Night abstracts (%B blue %M magenta %C cyan %G green %Y yellow %R red %K comment)
default_color = "-1";
abstracts = {
  line_start = "%K»%n ";
  timestamp = "%K$*%n";
  hilight = "%_$*%_";
  error = "%R$*%n";
  channel = "%M$*%n";
  nick = "%_$*%_";
  nickhost = "%K[%C$*%K]%n";
  server = "%_$*%_";
  comment = "%K[%n$*%K]%n";
  reason = "{comment $*}";
  mode = "{comment $*}";
  channick_hilight = "%C$*%n";
  chanhost_hilight = "{nickhost %C$*%n}";
  channick = "%c$*%n";
  chanhost = "{nickhost $*}";
  channelhilight = "%M$*%n";
  ban = "%R$*%n";
  msgnick = "%K<%n$0$1-%K>%n %|";
  ownmsgnick = "{msgnick $0 $1-}";
  ownnick = "%B$*%n";
  pubmsgnick = "{msgnick $0 $1-}";
  pubnick = "%M$*%n";
  pubmsgmenick = "{msgnick $0 $1-}";
  menick = "%Y$*%n";
  pubmsghinick = "{msgnick $1 $0$2-%n}";
  ownprivmsgnick = "{msgnick  $*}";
  privmsgnick = "{msgnick  %C$*%n}";
  action_core = "%M * $*%n";
  sb_background = "%0%w";
  sb_prompt_bg = "%n";
  sb = "%K[%n$*%K]%n ";
  sbmode = "(%C+%n$*)";
  sbaway = " (%GzZzZ%n)";
  sbservertag = ":$0 (change with ^X)";
  sbnickmode = "$0";
  sb_act_sep = "%K$*";
  sb_act_text = "%B$*";
  sb_act_msg = "%C$*";
  sb_act_hilight = "%M$*";
  sb_act_hilight_color = "$0$1-%n";
  prompt = "%B[%M$*%B]%n ";
};
