# Tokyo Night tig (ANSI indices -> VT palette)
set main-view = line-number:no,interval=5 id:yes date:relative author:abbreviated commit-title:yes,graph,refs,overflow=no
set vertical-split = auto
set split-view-height = 70%
set line-graphics = utf-8
set tab-size = 4
color default        default  default
color cursor         black    blue     bold
color title-focus    black    blue     bold
color title-blur     white    black
color status         cyan     default
color delimiter      color8   default
color date           cyan     default
color author         magenta  default
color id             yellow   default
color graph-commit   blue     default
color main-head      cyan     default  bold
color main-local-tag yellow   default  bold
color main-tag       yellow   default  bold
color main-remote    magenta  default
color main-tracked   green    default  bold
color main-ref       blue     default
color line-number    color8   default
color diff-header    blue     default  bold
color diff-chunk     magenta  default
color diff-add       green    default
color diff-del       red      default
color diff-stat      cyan     default
color stat-staged    green    default
color stat-unstaged  yellow   default
color stat-untracked magenta  default
color search-result  black    yellow
