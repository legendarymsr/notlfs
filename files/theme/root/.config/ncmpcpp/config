# Tokyo Night
colors_enabled = yes
empty_tag_color = black
header_window_color = blue
volume_color = cyan
state_line_color = black
state_flags_color = magenta:b
main_window_color = white
color1 = white
color2 = green
progressbar_color = black:b
progressbar_elapsed_color = magenta:b
statusbar_color = blue
statusbar_time_color = cyan:b
player_state_color = magenta:b
alternative_ui_separator_color = black:b
window_border_color = blue
active_window_border = magenta
current_item_prefix = $(magenta)$r
current_item_suffix = $/r$(end)
selected_item_prefix = $(cyan)
selected_item_suffix = $(end)
song_list_format = {$(blue)%a$(end) $(8)-$(end) }{$(white)%t$(end)}|{$(white)%f$(end)}$R{$(cyan)%l$(end)}
# ncmpcpp's default columns (the playlist view); theme day swaps in an uncolored copy
song_columns_list_format = (20)[]{a} (6f)[green]{NE} (50)[white]{t|f:Title} (20)[cyan]{b} (7f)[magenta]{l}
song_status_format = {$(magenta)%a$(end) - }{$(blue)%t$(end)}|{%f}
progressbar_look = ─╼─
# layout: playlist + visualizer split, alternative (big) header
user_interface = alternative
startup_screen = playlist
startup_slave_screen = visualizer
startup_slave_screen_focus = no
locked_screen_width_part = 60
ask_for_locked_screen_width_part = no
visualizer_data_source = /tmp/mpd.fifo
visualizer_output_name = visualizer
visualizer_in_stereo = yes
visualizer_type = wave_filled
visualizer_look = ▁▋
visualizer_color = blue, cyan, magenta
titles_visibility = no
header_visibility = yes
statusbar_visibility = yes
centered_cursor = yes
alternative_header_first_line_format = $b$5{%t}|{%f}$/b
alternative_header_second_line_format = {$4%a$9}{ · $6%b$9}
now_playing_prefix = $b$5▶ 
now_playing_suffix = $/b
