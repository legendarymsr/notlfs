#!/bin/sh
# console login: straight into tmux, fall back to a shell
. /etc/profile
T=$(tty)
case $T in
  /dev/tty[0-9]*) S=${T#/dev/} ;;                                   # VT: kernel knows the size
  *) S=main; stty cols ${COLS:-160} rows ${ROWS:-45} 2>/dev/null ;; # serial: no size info, set it
esac
tmux new -A -s $S || exec sh
