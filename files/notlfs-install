#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# notlfs-install [-y] [-e] /dev/sdX : WIPES the disk, makes one MBR ext4 partition,
# copies the running system onto it and installs extlinux (BIOS boot).
# -e: encrypted root: a small plain /boot partition + a LUKS2 (argon2id) root, unlocked at boot by a tiny initrd.
set -e
Y=; E=
while :; do case $1 in -y) Y=1; shift;; -e) E=1; shift;; *) break;; esac; done
D=$1
[ -b "$D" ] || { echo "usage: notlfs-install [-y] [-e] /dev/sdX   (disks: $(ls /sys/block | grep -v -e loop -e ram -e sr | tr '\n' ' '))"; exit 1; }
case $D in *[0-9]) P=${D}p1; P2=${D}p2;; *) P=${D}1; P2=${D}2;; esac
if [ -z "$Y" ]; then printf 'This erases everything on %s. Type yes: ' "$D"; read a; [ "$a" = yes ] || exit 1; fi

# kernel: from the boot ISO, or /boot/bzImage, or $KERNEL
K=${KERNEL:-}
if [ -z "$K" ]; then
  for c in /boot/bzImage /mnt/media/boot/bzImage; do [ -f $c ] && K=$c && break; done
fi
if [ -z "$K" ]; then
  mkdir -p /mnt/media
  for s in /dev/sr*; do  # any CD drive: keep the one that has the kernel
    [ -b $s ] && mount -t iso9660 -o ro $s /mnt/media 2>/dev/null || continue
    [ -f /mnt/media/boot/bzImage ] && { K=/mnt/media/boot/bzImage; break; }
    umount /mnt/media
  done
fi
[ -n "$K" ] || { echo "no kernel found: boot the ISO or set KERNEL=/path/to/bzImage"; exit 1; }

echo ">> partitioning $D"
umount $P 2>/dev/null || true
dd if=/dev/zero of=$D bs=1M count=4 2>/dev/null
if [ -n "$E" ]; then  # p1: 128 MiB /boot, p2: the rest (LUKS2)
  printf 'o\nn\np\n1\n2048\n+128M\nn\np\n2\n264192\n\na\n1\nw\n' | fdisk $D >/dev/null 2>&1 || true
else
  printf 'o\nn\np\n1\n2048\n\na\n1\nw\n' | fdisk $D >/dev/null 2>&1 || true
fi
SIG=$(hexdump -n 4 -e '1/4 "%08x"' /dev/urandom)
printf "\\x${SIG:6:2}\\x${SIG:4:2}\\x${SIG:2:2}\\x${SIG:0:2}" | dd of=$D bs=1 seek=440 conv=notrunc 2>/dev/null
dd if=/usr/share/syslinux/mbr.bin of=$D bs=440 count=1 conv=notrunc 2>/dev/null
blockdev --rereadpt $D 2>/dev/null || true
i=0; while [ ! -b $P ] && [ $i -lt 20 ]; do sleep 0.2; i=$((i+1)); done
[ -b $P ] || { echo "partition $P did not appear"; exit 1; }
T=/mnt/target; mkdir -p $T
if [ -n "$E" ]; then
  [ -b $P2 ] || { echo "partition $P2 did not appear"; exit 1; }
  echo ">> encrypting $P2 (LUKS2, argon2id): choose the disk passphrase"
  cryptsetup luksFormat -q --type luks2 --pbkdf argon2id --cipher aes-xts-plain64 --key-size 512 --verify-passphrase $P2
  LU=$(cryptsetup luksUUID $P2)
  echo ">> unlocking $P2"
  cryptsetup open --type luks2 $P2 notlfs-install
  R=/dev/mapper/notlfs-install
  echo ">> formatting $P (ext4, /boot) and $R (ext4, /)"
  mke2fs -q -F -t ext4 -O ^64bit,^metadata_csum -L notlfs-boot $P
  mke2fs -q -F -t ext4 -L notlfs $R
  mount -t ext4 $R $T; mkdir -p $T/boot; mount -t ext4 $P $T/boot
else
  echo ">> formatting $P (ext4)"
  mke2fs -q -F -t ext4 -O ^64bit,^metadata_csum -L notlfs $P
  mount -t ext4 $P $T
fi

echo ">> copying the system"
for d in /*; do
  case $d in /proc|/sys|/dev|/run|/tmp|/mnt|/media|/lost+found) continue;; esac
  cp -a $d $T/
done
mkdir -p $T/proc $T/sys $T/dev $T/run $T/tmp $T/mnt $T/boot/syslinux
chmod 1777 $T/tmp
cp $K $T/boot/bzImage

PU=$SIG-01
if [ -n "$E" ]; then
  cp /usr/share/notlfs/unlock.cpio.xz $T/boot/
  BU=$(blkid $P | sed -n 's/.* UUID="\([^"]*\)".*/\1/p')  # BusyBox mount knows UUID=, not PARTUUID=
  printf '/dev/mapper/notlfs-root / ext4 rw,noatime 0 1\nUUID=%s /boot ext4 rw,noatime,nodev,nosuid,noexec 0 2\n' $BU > $T/etc/fstab
  KP=/bzImage  # extlinux paths are relative to the /boot partition
  BOOT="INITRD /unlock.cpio.xz
  APPEND rdinit=/init notlfs.luks=$LU"
else
  echo "PARTUUID=$PU / ext4 rw,noatime 0 1" > $T/etc/fstab
  KP=/boot/bzImage
  BOOT="APPEND root=PARTUUID=$PU rootwait rw init=/init"
fi

echo ">> installing extlinux"
cp /usr/share/syslinux/*.c32 $T/boot/syslinux/
cat > $T/boot/syslinux/syslinux.cfg <<CFG
DEFAULT notlfs
PROMPT 1
TIMEOUT 30
LABEL notlfs
  LINUX $KP
  $BOOT console=ttyS0 console=tty1 loglevel=4 lockdown=confidentiality slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 pti=on randomize_kstack_offset=on vsyscall=none debugfs=off vt.default_red=26,247,158,224,122,187,125,192,86,247,158,224,122,187,125,192 vt.default_grn=27,118,206,175,162,154,207,202,95,118,206,175,162,154,207,202 vt.default_blu=38,142,106,104,247,247,255,245,137,142,106,104,247,247,255,245
# light mode: type 'day' at the boot: prompt
LABEL day
  LINUX $KP
  $BOOT console=ttyS0 console=tty1 loglevel=4 lockdown=confidentiality slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 pti=on randomize_kstack_offset=on vsyscall=none debugfs=off vt.default_red=225,245,88,140,46,152,0,55,97,255,92,162,53,164,0,55 vt.default_grn=226,42,117,108,125,84,113,96,114,71,133,118,138,99,126,96 vt.default_blu=231,101,57,62,233,241,151,191,176,116,36,41,255,255,168,191 notlfs.theme=day
CFG
extlinux --install $T/boot/syslinux >/dev/null
sync
[ -n "$E" ] && { umount $T/boot; umount $T; cryptsetup close notlfs-install; } || umount $T
echo ">> done: $D is bootable (BIOS). Remove the ISO and reboot."
