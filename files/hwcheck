#!/bin/sh
# hwcheck: quick hardware overview from /proc, /sys and BusyBox.
# Sensitive values (hostname, MACs, IPs, Wi-Fi SSID, serials) are masked.
# On a terminal: ctrl+r reveals them for 5 seconds, q / Esc / Enter quits.
case "${LC_ALL:-${LC_CTYPE:-$LANG}}" in *[Uu][Tt][Ff]*8*) MC='•';; *) MC='*';; esac
REVEAL=0
# s VALUE: print VALUE, or a same-width mask unless revealing
s() { if [ "$REVEAL" = 1 ] || [ -z "$1" ]; then printf %s "$1"
      else n=${#1}; [ "$n" -lt 4 ] && n=4; [ "$n" -gt 17 ] && n=17
      i=0; while [ $i -lt $n ]; do printf %s "$MC"; i=$((i+1)); done; fi; }
if [ -z "$NO_COLOR" ] && [ -t 1 ]; then
    B=$(printf '\033[1;38;2;122;162;247m'); D=$(printf '\033[38;2;86;95;137m'); R=$(printf '\033[0m')
else B= D= R=; fi
h() { printf '\n%s== %s ==%s\n' "$B" "$1" "$R"; }
kv() { printf '  %s%-10s%s %s\n' "$D" "$1" "$R" "$2"; }
human() { awk -v k="$1" 'BEGIN{s="KMGTP";i=1;while(k>=1024&&i<5){k/=1024;i++}printf "%.1f%s",k,substr(s,i,1)}'; }

draw() {
h System
kv kernel "$(uname -srm)"
kv host "$(s "$(uname -n)")"
kv uptime "$(awk '{s=int($1);printf "%dd %dh %dm",s/86400,s%86400/3600,s%3600/60}' /proc/uptime)"

h CPU
kv model "$(awk -F': ' '/^model name/{print $2;exit}' /proc/cpuinfo)"
kv cores "$(grep -c '^processor' /proc/cpuinfo)"
kv load "$(cut -d' ' -f1-3 /proc/loadavg)"

h Memory
t=$(awk '/^MemTotal/{print $2}' /proc/meminfo); a=$(awk '/^MemAvailable/{print $2}' /proc/meminfo)
kv total "$(human "$t")"; kv available "$(human "${a:-0}")"

h Disks
for d in /sys/block/*; do
    n=${d##*/}; case $n in loop*|ram*|zram*) continue;; esac
    sz=$(cat "$d/size" 2>/dev/null) || continue
    [ "$sz" -gt 0 ] || continue
    m=$(cat "$d/device/model" 2>/dev/null | sed 's/ *$//')
    r=$(cat "$d/queue/rotational" 2>/dev/null); [ "$r" = 0 ] && ty=ssd || ty=hdd
    sn=$(cat "$d/device/serial" 2>/dev/null | tr -d ' ')
    kv "$n" "$(human $((sz / 2)))  $ty  $m${sn:+  sn $(s "$sn")}"
done

h Filesystems
df -h 2>/dev/null | awk 'NR==1 || $1 ~ /^\/dev\//' | sed 's/^/  /'

h Network
for i in /sys/class/net/*; do
    n=${i##*/}; [ "$n" = lo ] && continue
    st=$(cat "$i/operstate" 2>/dev/null); mac=$(cat "$i/address" 2>/dev/null)
    ip4=$(ip -4 -o addr show dev "$n" 2>/dev/null | awk '{printf "%s ",$4}')
    ip4=${ip4% }
    kv "$n" "$(printf '%-7s' "$st")  $(s "$mac")  $(if [ -n "$ip4" ]; then s "$ip4"; else echo no ip; fi)"
    if [ -d "$i/wireless" ]; then
        ssid=
        command -v iwctl >/dev/null 2>&1 && ssid=$(iwctl station "$n" show 2>/dev/null |
            sed -n 's/^ *Connected network  *\(.*[^ ]\) *$/\1/p')
        sig=$(awk -v d="$n:" '$1==d{printf "%d%%",$3*100/70}' /proc/net/wireless 2>/dev/null)
        kv "  wifi" "$(if [ -n "$ssid" ]; then s "$ssid"; else echo not connected; fi)${sig:+  $sig}"
    fi
done

for b in /sys/class/power_supply/BAT*; do
    [ -r "$b/capacity" ] || continue
    h Battery; kv "${b##*/}" "$(cat "$b/capacity")%  $(cat "$b/status" 2>/dev/null)"
done

tz=
for z in /sys/class/thermal/thermal_zone*; do
    [ -r "$z/temp" ] || continue
    [ -n "$tz" ] || { h Temperatures; tz=1; }
    kv "$(cat "$z/type")" "$(awk '{printf "%.0f°C",$1/1000}' "$z/temp")"
done
for t in /sys/class/hwmon/hwmon*/temp*_input; do
    [ -r "$t" ] || continue
    [ -n "$tz" ] || { h Temperatures; tz=1; }
    hw=${t%/*}; l=$(cat "${t%_input}_label" 2>/dev/null)
    kv "$(cat "$hw/name")" "${l:+$l: }$(awk '{printf "%.0f°C",$1/1000}' "$t" 2>/dev/null)"
done

if command -v lspci >/dev/null 2>&1; then h PCI; lspci 2>/dev/null | sed 's/^/  /'; fi
if command -v lsusb >/dev/null 2>&1; then h USB; lsusb 2>/dev/null | sed 's/^/  /'; fi
echo
}

[ -t 0 ] && [ -t 1 ] || { draw; exit 0; }

old=$(stty -g)
restore() { stty "$old"; printf '\033[?25h'; }
trap 'restore; exit 0' INT TERM HUP
trap restore EXIT
key() { dd bs=1 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'; }
screen() {
    printf '\033[H\033[2J'; draw
    if [ "$REVEAL" = 1 ]; then printf '  %srevealed · hiding in 5s · q quit%s\n' "$D" "$R"
    else printf '  %sctrl+r reveal · q quit%s\n' "$D" "$R"; fi
}
printf '\033[?25l'
stty raw -echo isig opost onlcr min 1 time 0  # opost: keep \n -> \r\n so lines start at column 0
screen
while :; do
    k=$(key)
    case $k in
    12) REVEAL=1; screen
        # raw mode timeout: wait up to 5s (time is in tenths), quit keys still work
        stty min 0 time 50; k=$(key); stty min 1 time 0
        case $k in 71|1b|0d|0a) break;; esac
        REVEAL=0; screen;;
    71|1b|0d|0a|03) break;;
    esac
done
printf '\r\n'
