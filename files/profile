export PATH=/bin:/sbin:/usr/bin:/usr/sbin HOME=/root LANG=C.UTF-8 EDITOR=vis VISUAL=vis
[ -n "$TMUX" ] || export TERM=xterm-256color
# Tokyo Night: prompt, fzf, ls/grep (colors are ANSI indices; the VT palette makes them Tokyo Night)
E=$(printf '\033'); PS1="\[$E[35m\]\u\[$E[90m\]@\[$E[34m\]\h \[$E[36m\]\w \[$E[32m\]#\[$E[0m\] "; unset E
export FZF_DEFAULT_OPTS='--layout=reverse --border=sharp --height=60% --prompt="» " --pointer="▶" --marker="+" --info=inline-right --preview-window=right,55%,border-left --color=fg:-1,bg:-1,hl:blue,fg+:white,bg+:black,hl+:cyan,info:yellow,prompt:magenta,pointer:magenta,marker:green,spinner:cyan,header:bright-black,border:bright-black,gutter:-1'
export LESS=-R  # BusyBox less: no LESS_TERMCAP/overstrike support, so no colored man headings
export LF_COLORS='di=1;34:ln=36:ex=1;32:*.lua=35:*.jsonc=33:*.flac=35:*.webm=35'
alias ls='ls --color=auto' grep='grep --color=auto'
# jq (null:false:true:numbers:strings:arrays:objects:keys) and ripgrep
export JQ_COLORS='0;90:0;31:0;32:0;33:0;32:1;37:1;37:1;34' RIPGREP_CONFIG_PATH=/etc/ripgreprc
# dmesg: dim timestamps, red errors/failures, yellow warnings (BusyBox dmesg has no color)
dmesg() { local e; e=$(printf '\033'); command dmesg "$@" | sed -E "s/^\[[^]]*\]/$e[90m&$e[0m/; s/([Ee]rror|[Ff]ail[a-z]*)/$e[1;31m&$e[0m/g; s/([Ww]arn[a-z]*)/$e[33m&$e[0m/g; s/(Unstable|unknown)/$e[33m&$e[0m/g"; }
# Tokyo Night / Tokyo Night Day: re-apply the chosen palette (theme day|night switches)
case $(tty 2>/dev/null) in /dev/tty[0-9]*) [ -n "$TMUX" ] || theme --apply;; esac
