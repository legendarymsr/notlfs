#!/bin/sh
# yt: search YouTube through Invidious and play with mpv (no yt-dlp).
#   yt [query]      search + play         yt --refresh   re-test instances (adds api.invidious.io list)
#   env: YT_INSTANCES="host1 host2", YT_QUALITY=360 (max video height)
# All HTTPS goes through tget (LibreSSL, certificate verified); mpv verifies too (/etc/mpv/mpv.conf).
. /etc/profile 2>/dev/null
C=${XDG_CACHE_HOME:-$HOME/.cache}/yt-instances
INST=${YT_INSTANCES:-$(cat "$C" 2>/dev/null || cat /etc/yt-instances 2>/dev/null)}
say() { printf '\033[90m%s\033[0m\n' "$*" >&2; }
Q=${YT_QUALITY:-360}
case $Q in ''|*[!0-9]*|0*) say "yt: YT_QUALITY='$Q' is not a positive number, using 360"; Q=360;; esac
# private temp dir (umask 077 + mktemp -d), removed on any exit
umask 077; T=$(mktemp -d "${TMPDIR:-/tmp}/yt.XXXXXX") || exit 1; HF=$T/host
trap 'rm -rf "$T"' EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
# per-endpoint shape checks: search = array of videos with string id/title; video = streams with string urls
SEARCH='type=="array" and length>0 and all(.[]; type=="object") and any(.[]; .type=="video" and (.videoId|type)=="string" and (.title|type)=="string")'
VIDEO='type=="object" and (.title|type)=="string" and (.adaptiveFormats|type)=="array" and (.formatStreams|type)=="array" and all(.adaptiveFormats[]; (.url|type)=="string" and (.type|type)=="string")'
json() { printf '%s' "$1" | jq -e "$2" >/dev/null 2>&1; }
# probe URL: first 64 KiB must arrive and start with the WebM/EBML magic, so the stream is really being served
probe() { tget -t 10 "$1" 2>/dev/null | head -c 65536 > "$T/p"; [ "$(wc -c < "$T/p")" -eq 65536 ] && [ "$(head -c 4 "$T/p" | od -An -tx1 | tr -d ' \n')" = 1a45dfa3 ]; }
# api PATH CHECK: try every instance in order; records the one that answered in $HF
api() { for h in $INST; do r=$(tget -t 15 "https://$h$1" 2>/dev/null) && json "$r" "$2" && { echo "$h" > "$HF"; printf '%s' "$r"; return 0; }; say "  $h: no answer, next"; done; return 1; }
if [ "$1" = --refresh ]; then
  cand=$( { tget https://api.invidious.io/instances.json 2>/dev/null | jq -r '.[]|select(.[1].type=="https")|.[0]'; cat /etc/yt-instances; } | awk '!s[$0]++')
  ok=; for h in $cand; do r=$(tget -t 10 "https://$h/api/v1/search?type=video&q=test" 2>/dev/null) && json "$r" "$SEARCH" && { ok="$ok$h
"; say "ok   $h"; } || say "fail $h"; done
  [ -n "$ok" ] && mkdir -p "${C%/*}" && printf '%s' "$ok" > "$C" && echo "yt: $(printf '%s' "$ok" | wc -l) working instance(s) saved to $C"; exit
fi
q=$*; [ -n "$q" ] || { printf '\033[35msearch\033[90m›\033[0m '; read -r q; }
[ -n "$q" ] || exit 0
q=$(printf '%s' "$q" | jq -sRr @uri)
res=$(api "/api/v1/search?type=video&q=$q" "$SEARCH") && H=$(cat "$HF") || { echo "yt: no Invidious instance answered ($INST) - try: yt --refresh" >&2; exit 1; }
pick=$(printf '%s' "$res" | jq -r '.[] | select(.type=="video" and (.videoId|type)=="string") | "\(.videoId)\t\(.lengthSeconds/60|floor):\(.lengthSeconds%60|tostring|if length<2 then "0"+. else . end)\t\(.author)\t\(.title)"' |
  fzf --delimiter='\t' --with-nth=2.. --prompt="yt ($H) » " --header='enter: play   esc: quit' --tabstop=2) || exit 0
id=${pick%%	*}
# playback: walk the instances until one returns streams that probe fine and mpv actually plays
for h in $INST; do
  v=$(tget -t 20 "https://$h/api/v1/videos/$id?local=true" 2>/dev/null) && json "$v" "$VIDEO" || { say "  $h: no video info, next"; continue; }
  abs() { case $1 in /*) echo "https://$h$1";; *) echo "$1";; esac; }
  au=$(abs "$(printf '%s' "$v" | jq -r '[.adaptiveFormats[] | select(.type|startswith("audio/webm"))] | sort_by(.bitrate|tonumber) | last | .url // empty')")
  [ -n "$au" ] && probe "$au" || { say "  $h: audio stream blocked, next"; continue; }
  vu=$(printf '%s' "$v" | jq -r --argjson q "$Q" '[.adaptiveFormats[] | select(.type|startswith("video/webm")) | select((.resolution//"0p"|rtrimstr("p")|tonumber) <= $q)] | sort_by(.resolution//"0p"|rtrimstr("p")|tonumber) | last | .url // empty')
  [ -n "$vu" ] && { vu=$(abs "$vu"); probe "$vu" || { say "  $h: video stream blocked, next"; continue; }; }
  title=$(printf '%s' "$v" | jq -r .title)
  echo "▶ $title  ($h)"
  if [ -n "$vu" ]; then mpv --force-media-title="$title" --audio-file="$au" "$vu"
  else mpv --force-media-title="$title" --no-video "$au"; fi
  # mpv: 0 = played/quit normally, 4 = quit by signal (Ctrl+C) -> done; anything else = playback failed -> next instance
  case $? in 0|4) exit 0;; esac
  say "  $h: playback failed, next"
done
echo "yt: no instance could play $id" >&2; exit 1
