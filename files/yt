#!/bin/sh
# yt: search YouTube through an Invidious instance and play with mpv (no yt-dlp).
# yt [query]   env: YT_INSTANCES="host1 host2", YT_QUALITY=360 (max video height)
. /etc/profile 2>/dev/null
INST=${YT_INSTANCES:-$(cat /etc/yt-instances 2>/dev/null)}
Q=${YT_QUALITY:-360}
api() { for h in $INST; do r=$(wget -qO- -T 12 "https://$h$1" 2>/dev/null) && case $r in \[*|\{*) H=$h; printf '%s' "$r"; return 0;; esac; done; return 1; }
q=$*; [ -n "$q" ] || { printf '\033[35msearch\033[90m›\033[0m '; read -r q; }
[ -n "$q" ] || exit 0
q=$(printf '%s' "$q" | jq -sRr @uri)
res=$(api "/api/v1/search?type=video&q=$q") || { echo "yt: no Invidious instance answered ($INST)" >&2; exit 1; }
pick=$(printf '%s' "$res" | jq -r '.[] | select(.type=="video") | "\(.videoId)\t\(.lengthSeconds/60|floor):\(.lengthSeconds%60|tostring|if length<2 then "0"+. else . end)\t\(.author)\t\(.title)"' |
  fzf --delimiter='\t' --with-nth=2.. --prompt='yt » ' --header='enter: play   esc: quit' --tabstop=2) || exit 0
id=${pick%%	*}
v=$(api "/api/v1/videos/$id?local=true") || { echo "yt: could not load video $id" >&2; exit 1; }
abs() { case $1 in /*) echo "https://$H$1";; *) echo "$1";; esac; }
vu=$(printf '%s' "$v" | jq -r --argjson q "$Q" '[.adaptiveFormats[] | select(.type|startswith("video/webm")) | select((.resolution//"0p"|rtrimstr("p")|tonumber) <= $q)] | sort_by(.resolution//"0p"|rtrimstr("p")|tonumber) | last | .url // empty')
au=$(printf '%s' "$v" | jq -r '[.adaptiveFormats[] | select(.type|startswith("audio/webm"))] | sort_by(.bitrate|tonumber) | last | .url // empty')
title=$(printf '%s' "$v" | jq -r .title)
[ -n "$au" ] || { echo "yt: no playable streams for $id" >&2; exit 1; }
echo "▶ $title"
if [ -n "$vu" ]; then exec mpv --force-media-title="$title" --audio-file="$(abs "$au")" "$(abs "$vu")"
else exec mpv --force-media-title="$title" --no-video "$(abs "$au")"; fi
