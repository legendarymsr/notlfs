#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# notlfs stage 2: one-shot setup. s6-svscan is already running the services in /run/service.
# /proc /sys /dev/pts /dev/shm /tmp are mounted (nosuid,nodev,noexec) by /init
# amnesic boot (boot: amnesic): the system already runs from RAM; every disk is forced read-only and nothing
# is mounted or swapped, also for disks plugged in later. /tmp is tmpfs either way.
if grep -qw notlfs.amnesic /proc/cmdline; then
  : > /run/notlfs-amnesic
  (while :; do for b in /sys/block/*; do case ${b##*/} in loop*|ram*|dm-*|zram*) ;; *) blockdev --setro /dev/${b##*/} 2>/dev/null;; esac; done; sleep 2; done) &
  echo "notlfs: AMNESIC: running from RAM, disks read-only, nothing is written anywhere"
else
  mount -o remount,rw / 2>/dev/null
  mount -a 2>/dev/null
  notlfs-cryptswap
fi
mkdir -p /var/log /tmp
hostname -F /etc/hostname
ip link set lo up
loadkmap < /etc/us-altshift.bmap 2>/dev/null  # US keymap + Alt+Shift keys (kernel default leaves them dead) for the tmux binds
for t in /dev/tty1 /dev/tty2; do busybox setfont -C $t /usr/share/consolefonts/ter-v28n.psf 2>/dev/null; done  # bigger, readable console font
echo "Welcome to notlfs (s6)"
(amixer -q sset Master 80% unmute; amixer -q sset PCM 80% unmute) >/dev/null 2>&1 &
exit 0
